# Copy to .env (never commit .env). Placeholders only.
FIRMS_MAP_KEY=your_firms_map_key_here        # free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
ALLOWED_ORIGINS=http://localhost:8000,https://<your-username>.github.io
FIRES_CACHE_SECONDS=900
TLE_CACHE_SECONDS=21600
HTTP_TIMEOUT=45
LANDCOVER_ROOT=/path/to/LandCover          # holds ESA_WorldCover_2021_v200/, MODIS_MCD12Q1_061_<year>/, ORNL_India_LULC_1985_1995_2005/
MODIS_LC_YEAR=2025
EARTHDATA_USERNAME=your_earthdata_username   # only for scripts/download_landcover.py
EARTHDATA_PASSWORD=your_earthdata_password
